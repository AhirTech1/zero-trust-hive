# Zero-Trust Hive — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# You can also generate a secure .env automatically:
#   hive init

# HMAC-SHA256 secret for JWT token signing/validation (REQUIRED)
# Generate with: openssl rand -hex 32
HIVE_JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Bootstrap JWT token — valid 24 hours, scope: admin
# Generate via `hive init` or programmatically with GenerateToken()
HIVE_BOOTSTRAP_TOKEN=